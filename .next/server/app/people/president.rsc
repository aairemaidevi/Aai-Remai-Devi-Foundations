0:["lIMvQwsXk0YIEAQs_GnsD",[[["",{"children":["people",{"children":[["slug","president","d"],{"children":["__PAGE__?{\"slug\":\"president\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["people",{"children":[["slug","president","d"],{"children":["__PAGE__",{},[["$L1",["$","main",null,{"className":"page_page__YnrZJ","children":["$","div",null,{"className":"page_shell__tD8IF","children":[["$","$L2",null,{"href":"/#people-behind-the-promise","className":"page_backLink__7ifhn","children":[["$","$L3",null,{"iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":17,"aria-hidden":"true"}],"Back to our people"]}],["$","div",null,{"className":"page_profile__CUVAn","children":[["$","div",null,{"className":"page_photoPanel__QD0G0","children":[["$","img",null,{"className":"page_photo__2NxNc","src":"https://yurxhxxizunhzqipschx.supabase.co/storage/v1/object/public/site-images/OUR%20PEOPLE/President.jpeg","alt":"Shri. Santosh Waman Kate portrait"}],["$","span",null,{"className":"page_number__mATX4","children":"02"}]]}],["$","article",null,{"className":"page_message__eOxTh","children":[["$","span",null,{"className":"page_eyebrow__xnH_v","children":"Aai Ramai Educational and Social Institution"}],["$","p",null,{"className":"page_sequence__b8ErI","children":"The people behind the promise"}],["$","h1",null,{"children":"Shri. Santosh Waman Kate"}],["$","p",null,{"className":"page_designation__epDAh","children":["Designation: ","President"," ",["$","span",null,{"aria-hidden":"true","children":"·"}]," ","अध्यक्ष"]}],["$","p",null,{"className":"$undefined","children":"श्री. संतोष वामन काते"}],["$","div",null,{"className":"page_rule__PxhTo"}],["$","div",null,{"className":"page_copy__gSfPh","children":[["$","p","Aai Ramai Educational and Social Institution has been established with the vision of contributing to the development of our village and promoting the overall progress and welfare of every section of society. Our institution is committed to bringing together the citizens of our village and working collectively in various fields such as social welfare, education, healthcare, sports, culture, environmental conservation, and the development of women and children.",{"children":"Aai Ramai Educational and Social Institution has been established with the vision of contributing to the development of our village and promoting the overall progress and welfare of every section of society. Our institution is committed to bringing together the citizens of our village and working collectively in various fields such as social welfare, education, healthcare, sports, culture, environmental conservation, and the development of women and children."}],["$","p","This institution does not belong to any individual or to a select few. It is an institution of the entire village and for the entire village. Our primary objective is to ensure that assistance reaches every deserving person through the institution, to provide proper educational encouragement and guidance to the youth, and to undertake constructive initiatives for the overall development of the village.",{"children":"This institution does not belong to any individual or to a select few. It is an institution of the entire village and for the entire village. Our primary objective is to ensure that assistance reaches every deserving person through the institution, to provide proper educational encouragement and guidance to the youth, and to undertake constructive initiatives for the overall development of the village."}],["$","p","Transparency, trust, discipline, and a proper decision-making process are of utmost importance in every activity undertaken by the institution. A position within the institution is not merely a matter of honour or recognition; it carries with it a responsibility. We expect every office-bearer and member to perform their duties with this sense of responsibility and commitment.",{"children":"Transparency, trust, discipline, and a proper decision-making process are of utmost importance in every activity undertaken by the institution. A position within the institution is not merely a matter of honour or recognition; it carries with it a responsibility. We expect every office-bearer and member to perform their duties with this sense of responsibility and commitment."}],["$","p","The institution cannot function successfully without the cooperation and support of all. Therefore, with the trust and participation of the senior citizens, the enthusiasm of the youth, women, students, and every villager, let us work together to make this institution stronger, more effective, and an exemplary organisation.",{"children":"The institution cannot function successfully without the cooperation and support of all. Therefore, with the trust and participation of the senior citizens, the enthusiasm of the youth, women, students, and every villager, let us work together to make this institution stronger, more effective, and an exemplary organisation."}],["$","p","With the blessings of Aai Ramai Devi, our firm resolve is to contribute to the development of the village by working selflessly, continuously, and with dedication. Through collective efforts and unity, we aspire to create meaningful and lasting progress for our community.",{"children":"With the blessings of Aai Ramai Devi, our firm resolve is to contribute to the development of the village by working selflessly, continuously, and with dedication. Through collective efforts and unity, we aspire to create meaningful and lasting progress for our community."}],["$","p","For the institution to grow, the society it serves must grow through the institution.",{"children":"For the institution to grow, the society it serves must grow through the institution."}]]}]]}]]}],["$","nav",null,{"className":"page_profileNav__nX0Dg","aria-label":"Committee members","children":[["$","$L2","trustee",{"href":"/people/trustee","classNam