0:["lIMvQwsXk0YIEAQs_GnsD",[[["",{"children":["people",{"children":[["slug","secretary","d"],{"children":["__PAGE__?{\"slug\":\"secretary\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["people",{"children":[["slug","secretary","d"],{"children":["__PAGE__",{},[["$L1",["$","main",null,{"className":"page_page__YnrZJ","children":["$","div",null,{"className":"page_shell__tD8IF","children":[["$","$L2",null,{"href":"/#people-behind-the-promise","className":"page_backLink__7ifhn","children":[["$","$L3",null,{"iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":17,"aria-hidden":"true"}],"Back to our people"]}],["$","div",null,{"className":"page_profile__CUVAn","children":[["$","div",null,{"className":"page_photoPanel__QD0G0","children":[["$","img",null,{"className":"page_photo__2NxNc","src":"https://yurxhxxizunhzqipschx.supabase.co/storage/v1/object/public/site-images/OUR%20PEOPLE/secretary.jpeg","alt":"Shri. Sagar Keshav Khedekar portrait"}],["$","span",null,{"className":"page_number__mATX4","children":"03"}]]}],["$","article",null,{"className":"page_message__eOxTh","children":[["$","span",null,{"className":"page_eyebrow__xnH_v","children":"Aai Ramai Social Institution"}],["$","p",null,{"className":"page_sequence__b8ErI","children":"The people behind the promise"}],["$","h1",null,{"children":"Shri. Sagar Keshav Khedekar"}],["$","p",null,{"className":"page_designation__epDAh","children":["Designation: ","Secretary"," ",["$","span",null,{"aria-hidden":"true","children":"·"}]," ","सचिव"]}],"$undefined",["$","div",null,{"className":"page_rule__PxhTo"}],["$","div",null,{"className":"page_copy__gSfPh","children":[["$","p","Aai Ramai Social Institution, Ghonse, is a symbol of our unity, service, and social responsibility. Keeping in mind the needs and concerns of every family, youth, woman, student, and senior citizen in our village, we have collectively envisioned working towards the overall development and welfare of our community.",{"children":"Aai Ramai Social Institution, Ghonse, is a symbol of our unity, service, and social responsibility. Keeping in mind the needs and concerns of every family, youth, woman, student, and senior citizen in our village, we have collectively envisioned working towards the overall development and welfare of our community."}],["$","p","As the Secretary, my role is not limited merely to overseeing the administrative functioning of the institution. My responsibility is to ensure proper coordination among all office-bearers and members so that the institution’s objectives, policies, plans, and every initiative are implemented effectively and in an organised manner.",{"children":"As the Secretary, my role is not limited merely to overseeing the administrative functioning of the institution. My responsibility is to ensure proper coordination among all office-bearers and members so that the institution’s objectives, policies, plans, and every initiative are implemented effectively and in an organised manner."}],["$","p","Special emphasis will be placed on transparency, discipline, responsibility, and proper time management in all the activities of the institution. We are committed to maintaining proper records of every decision taken by the institution, planning and documenting various activities, preparing reports, and ensuring that accurate and relevant information reaches all members of the institution in a timely manner.",{"children":"Special emphasis will be placed on transparency, discipline, responsibility, and proper time management in all the activities of the institution. We are committed to maintaining proper records of every decision taken by the institution, planning and documenting various activities, preparing reports, and ensuring that accurate and relevant information reaches all members of the institution in a timely manner."}],["$","p","Through our institution, we aim to undertake concrete and long-term initiatives in the fields of education, healthcare, sports, women and child development, environmental conservation, agriculture, culture, and social service.",{"children":"Through our institution, we aim to undertake concrete and long-term initiatives in the fields of education, healthcare, sports, women and child development, environmental conservation, agriculture, culture, and social service."}],["$","p","In my opinion, the true strength of an institution does not lie merely in its office-bearers, but in every member who is sincerely and faithfully connected with the institution and its vision. Therefore, let us all set aside our individual differences and work together with unity and dedication towards achieving the objectives of the institution.",{"children":"In my opinion, the true strength of an institution does not lie merely in its office-bearers, but in every member who is sincerely and faithfully connected with the institution and its vision. Therefore, let us all set aside our individual differences and work together with unity and dedication towards achieving the objectives of the institution."}],["$","p","With the blessings of Aai Ramai Devi and the cooperation of everyone, I am fully confident that this institution will remain dedicated to the welfare and development of our village and, through its work, establish itself as an exemplary social institution in the district.",{"children":"With the blessings of Aai Ramai Devi and the cooperation of everyone, I am fully confident that this institution will remain dedicated to the welfare and development of our village and, through its work, establish itself as an exemplary social institution in the district."}]]}]]}]]}],["$","nav",null,{"className":"page_profileNav__nX0Dg","aria-label":"Committee members","children":[["$","$L2","trustee",{"href":"/people/trustee","className":"","children":["Trustee",["$","$L3",null,{"iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7"